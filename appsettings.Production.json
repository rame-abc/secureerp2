{
  "ConnectionStrings": {
    "DefaultConnection": "Server=production-db-host;Database=SecureERP2_Production;User Id=secureerp_user;Password=PROD_PASSWORD_PLACEHOLDER;TrustServerCertificate=true;Encrypt=true;",
    "RedisCache": "production-redis-host:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error",
      "Microsoft.EntityFrameworkCore.Query": "Warning",
      "SecureERP2": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "File": {
      "Path": "logs/secureerp2-production.log",
      "Append": true,
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 30
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "https://api.secureerp2.com",
      "Audience": "https://api.secureerp2.com",
      "SecretKey": "PROD_JWT_SECRET_KEY_PLACEHOLDER_MINIMUM_32_CHARACTERS",
      "ExpirationMinutes": 60,
      "RefreshTokenExpirationDays": 7
    },
    "AzureAd": {
      "Enabled": false,
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 52428800,
      "MaxRequestBufferSize": 65536,
      "MaxRequestHeaderCount": 100
    }
  },
  "AllowedHosts": "api.secureerp2.com;localhost;127.0.0.1",
  "Environment": "Production",
  "Caching": {
    "Enabled": true,
    "DefaultExpirationMinutes": 30,
    "SizeLimit": 1000,
    "CompactionPercentage": 0.05,
    "SlidingExpiration": false
  },
  "ResponseCompression": {
    "Enabled": true,
    "EnableForHttps": true,
    "Providers": [
      {
        "MimeType": "application/json",
        "CompressionLevel": "Optimal"
      },
      {
        "MimeType": "text/plain",
        "CompressionLevel": "Optimal"
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://secureerp2.com",
      "https://www.secureerp2.com",
      "https://app.secureerp2.com"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization", "X-Correlation-ID" ],
    "ExposedHeaders": [ "X-Correlation-ID" ],
    "AllowCredentials": true,
    "PreflightMaxAge": 86400
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 1000,
    "Window": "00:01:00",
    "EndpointWhitelist": [
      "/health",
      "/health/detailed",
      "/health/database",
      "/health/ready",
      "/health/live"
    ]
  },
  "Security": {
    "RequireHttps": true,
    "Hsts": {
      "Enabled": true,
      "MaxAge": 31536000,
      "IncludeSubDomains": true,
      "Preload": true
    },
    "ContentSecurityPolicy": {
      "Enabled": true,
      "Directives": {
        "DefaultSrc": "'self'",
        "ScriptSrc": "'self' 'unsafe-inline'",
        "StyleSrc": "'self' 'unsafe-inline'",
        "ImgSrc": "'self' data: https:",
        "FontSrc": "'self'",
        "ConnectSrc": "'self' https:",
        "FrameSrc": "'none'",
        "ObjectSrc": "'none'"
      }
    }
  },
  "Monitoring": {
    "ApplicationInsights": {
      "Enabled": false,
      "ConnectionString": ""
    },
    "Prometheus": {
      "Enabled": true,
      "Endpoint": "/metrics"
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "Endpoints": {
      "Health": "/health",
      "Detailed": "/health/detailed",
      "Database": "/health/database",
      "Ready": "/health/ready",
      "Live": "/health/live"
    },
    "Tags": [
      "production",
      "finance",
      "erp"
    ]
  },
  "FeatureFlags": {
    "EnableAdvancedReporting": true,
    "EnableRealTimeNotifications": true,
    "EnableAdvancedAnalytics": true,
    "EnableMultiTenant": true,
    "EnableAuditLogging": true,
    "EnablePerformanceMonitoring": true
  },
  "Backup": {
    "Enabled": true,
    "Schedule": "0 2 * * *",
    "RetentionDays": 90,
    "CompressionEnabled": true,
    "StorageLocation": "/backups/secureerp2"
  }
}
