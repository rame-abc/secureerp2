        // Initialize database with seed data (enhanced)
        public async Task InitializeDatabaseAsync()
        {
            try
            {
                // Create database if it doesn't exist
                await _context.Database.EnsureCreatedAsync();

                // Check if data already exists
                if (await _context.Roles.AnyAsync())
                {
                    _logger.LogInformation("Database already initialized");
                    return;
                }

                // Seed initial data in correct order
                await SeedRolesAsync();
                await SeedRolePermissionsAsync();
                await SeedUsersAsync();
                await SeedFinanceAccountsAsync();
                await SeedProductsAsync();
                await SeedInventoryAsync();
                await SeedOrdersAsync();
                await SeedTransactionsAsync();
                await SeedAnalyticsAsync();

                await _context.SaveChangesAsync();
                _logger.LogInformation("Enhanced database initialized successfully");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error initializing database");
                throw;
            }
        }

        // Authentication methods (enhanced)
        public async Task<User?> AuthenticateUserAsync(string username, string password)
        {
            var user = await _context.Users
                .Include(u => u.Role)
                .FirstOrDefaultAsync(u => u.Username == username && u.IsActive);

            if (user == null) return null;

            // Verify password (simple hash for demo - in production use proper password hashing)
            var hashedPassword = HashPassword(password);
            if (user.PasswordHash == hashedPassword)
            {
                // Update last login
                user.LastLoginAt = DateTime.UtcNow;
                await _context.SaveChangesAsync();
                return user;
            }

            return null;
        }

        // Get user by username (for token validation)
        public async Task<User?> GetUserByUsernameAsync(string username)
        {
            return await _context.Users
                .Include(u => u.Role)
                .FirstOrDefaultAsync(u => u.Username == username && u.IsActive);
        }

        // Get user permissions (combines role and user-specific permissions)
        public async Task<Dictionary<string, string>> GetUserPermissionsAsync(int userId)
        {
            var permissions = new Dictionary<string, string>();

            // Get role permissions
            var user = await _context.Users
                .Include(u => u.Role)
                .ThenInclude(r => r.RolePermissions)
                .FirstOrDefaultAsync(u => u.Id == userId && u.IsActive);

            if (user?.Role != null)
            {
                foreach (var rolePerm in user.Role.RolePermissions)
                {
                    permissions[rolePerm.PermissionName] = rolePerm.PermissionValue;
                }
            }

            // Get user-specific permission overrides
            var userPerms = await _context.UserPermissions
                .Where(up => up.UserId == userId)
                .ToListAsync();

            foreach (var userPerm in userPerms)
            {
                permissions[userPerm.PermissionName] = userPerm.PermissionValue;
            }

            return permissions;
        }

        // Check if user has specific permission
        public async Task<bool> HasPermissionAsync(int userId, string permissionName)
        {
            var permissions = await GetUserPermissionsAsync(userId);
            return permissions.TryGetValue(permissionName, out var value) && value == "true";
        }

