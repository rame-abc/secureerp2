        // Analytics methods
        public async Task<List<AnalyticsSummary>> GetAnalyticsAsync(DateOnly? fromDate = null, DateOnly? toDate = null)
        {
            var query = _context.AnalyticsSummaries.AsQueryable();

            if (fromDate.HasValue)
                query = query.Where(a => a.MetricDate >= fromDate.Value);

            if (toDate.HasValue)
                query = query.Where(a => a.MetricDate <= toDate.Value);

            return await query
                .OrderByDescending(a => a.MetricDate)
                .ThenBy(a => a.Category)
                .ThenBy(a => a.MetricName)
                .ToListAsync();
        }

