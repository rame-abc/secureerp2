        // Create user session
        public async Task<UserSession> CreateUserSessionAsync(int userId, string sessionToken, DateTime expiresAt, string? ipAddress = null, string? userAgent = null)
        {
            var session = new UserSession
            {
                UserId = userId,
                SessionToken = sessionToken,
                ExpiresAt = expiresAt,
                IPAddress = ipAddress,
                UserAgent = userAgent,
                IsActive = true,
                CreatedAt = DateTime.UtcNow
            };

            _context.UserSessions.Add(session);
            await _context.SaveChangesAsync();

            return session;
        }

        // Validate session
        public async Task<UserSession?> ValidateSessionAsync(string sessionToken)
        {
            var session = await _context.UserSessions
                .Include(s => s.User)
                .ThenInclude(u => u.Role)
                .FirstOrDefaultAsync(s => s.SessionToken == sessionToken && s.IsActive && s.ExpiresAt > DateTime.UtcNow);

            return session;
        }

        // Revoke session
        public async Task<bool> RevokeSessionAsync(string sessionToken)
        {
            var session = await _context.UserSessions
                .FirstOrDefaultAsync(s => s.SessionToken == sessionToken);

            if (session == null) return false;

            session.IsActive = false;
            await _context.SaveChangesAsync();

            return true;
        }

        // Cleanup expired sessions
        public async Task CleanupExpiredSessionsAsync()
        {
            var expiredSessions = await _context.UserSessions
                .Where(s => s.ExpiresAt < DateTime.UtcNow)
                .ToListAsync();

            _context.UserSessions.RemoveRange(expiredSessions);
            await _context.SaveChangesAsync();
        }

        // Dashboard data methods
        public async Task<Dictionary<string, object>> GetDashboardMetricsAsync()
        {
            var metrics = new Dictionary<string, object>();

            // Financial metrics
            var totalRevenue = await _context.Transactions
                .Where(t => t.TransactionType == "Sale" && t.CreditAmount > 0)
                .SumAsync(t => t.CreditAmount);

            var totalExpenses = await _context.Transactions
                .Where(t => t.TransactionType == "Purchase" && t.DebitAmount > 0)
                .SumAsync(t => t.DebitAmount);

            var inventoryValue = await _context.Inventory
                .Join(_context.Products, i => i.ProductId, p => p.Id, (i, p) => new { i.Quantity, p.UnitPrice })
                .SumAsync(x => x.Quantity * x.UnitPrice);

            var activeOrders = await _context.Orders
                .CountAsync(o => o.Status == "Pending" || o.Status == "Confirmed");

            // Add metrics to dictionary
            metrics["TotalRevenue"] = totalRevenue;
            metrics["TotalExpenses"] = totalExpenses;
            metrics["Profit"] = totalRevenue - totalExpenses;
            metrics["InventoryValue"] = inventoryValue;
            metrics["ActiveOrders"] = activeOrders;
            metrics["PendingApprovals"] = 5; // Placeholder

            return metrics;
        }

